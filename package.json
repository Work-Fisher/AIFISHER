{
  "name": "aifisher-canvas",
  "private": true,
  "version": "2.0.7",
  "type": "module",
  "scripts": {
    "brand:assets": "node scripts/runtime/run.mjs scripts/generate-app-icon.mjs",
    "build:model-catalog": "node scripts/runtime/run.mjs scripts/build-model-catalog.mjs",
    "build:stable": "npm run brand:assets && npm run build:model-catalog && node scripts/runtime/run.mjs node_modules/vite/bin/vite.js build --config vite.stable.config.ts",
    "typecheck": "node scripts/runtime/run.mjs node_modules/typescript/bin/tsc -b tsconfig.json apps/desktop/launcher/tsconfig.json",
    "runtime:setup": "node scripts/runtime/setup.mjs",
    "runtime:check": "node scripts/runtime/run.mjs --check",
    "runtime:npm": "node scripts/runtime/run.mjs --npm",
    "build": "npm run build:stable",
    "desktop:dev": "node scripts/runtime/run.mjs scripts/desktop/startSource.mjs",
    "build:launcher": "node scripts/runtime/run.mjs node_modules/vite/bin/vite.js build --config apps/desktop/launcher/vite.config.ts",
    "unit": "node scripts/runtime/run.mjs node_modules/vitest/vitest.mjs run --config vite.config.ts",
    "check": "npm run typecheck && npm run unit && npm run build:stable && npm run build:launcher"
  },
